    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "function readNodeText(nodeName) {\n  const item = $(nodeName).first();\n  if (!item) return { text: '', error: 'nodo no ejecutado' };\n  if (item.json && item.json.error) return { text: '', error: String(item.json.error) };\n  if (!item.binary || !item.binary.data) return { text: '', error: null };\n  try {\n    return { text: Buffer.from(item.binary.data.data, 'base64').toString('utf-8'), error: null };\n  } catch (e) {\n    return { text: '', error: e.message };\n  }\n}\n\nfunction parseJsonl(text) {\n  return text.split('\\n').map(l => l.trim()).filter(Boolean).map(l => {\n    try { return JSON.parse(l); } catch (e) { return null; }\n  }).filter(Boolean);\n}\n\nconst rsvpRead = readNodeText('Leer RSVP');\nconst alergiasRead = readNodeText('Leer Alergias');\n\nreturn [{\n  json: {\n    rsvp: parseJsonl(rsvpRead.text),\n    alergias: parseJsonl(alergiasRead.text),\n    rsvpError: rsvpRead.error,\n    alergiasError: alergiasRead.error\n  }\n}];"
      },
